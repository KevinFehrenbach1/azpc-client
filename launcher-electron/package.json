{
  "name": "azpc-approved-launcher",
  "version": "1.0.31",
  "private": true,
  "description": "AZPC Electron desktop launcher",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "market.azpc.launcher",
    "productName": "AZPC Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "game-detection.js",
      "index.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "AZPC-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AZPC Launcher"
    }
  }
}
